# Copy to .env (gitignored). Values are in Firebase Console → Project settings → Your apps → Web app.
# VITE_ vars are baked in at `npm run build` / Docker frontend-build — set them on Railway too.

# VITE_API_BASE=

# VITE_ALLOW_DEV_LOGIN=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=friday-night-dynasty.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=friday-night-dynasty
VITE_FIREBASE_STORAGE_BUCKET=friday-night-dynasty.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
