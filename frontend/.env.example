# Copy to .env (gitignored). Values: Firebase Console → Project settings → Your apps → Web app.
# Local dev: VITE_* works. Railway production: prefer FIREBASE_WEB_CONFIG_JSON or FND_FIREBASE_* (see docs/FIREBASE_SECRETS.md).

# Vite dev proxy target (optional). Default in vite.config.ts is http://127.0.0.1:8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_ALLOW_DEV_LOGIN=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=friday-night-dynasty.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=friday-night-dynasty
VITE_FIREBASE_STORAGE_BUCKET=friday-night-dynasty.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Railway (server runtime) — same values, no VITE_ prefix:
# FND_FIREBASE_API_KEY=
# FND_FIREBASE_AUTH_DOMAIN=friday-night-dynasty.firebaseapp.com
# ... or one line:
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"...","authDomain":"...",...}

# Stripe one-time purchase (Railway server env — never commit real keys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FND_BILLING_REQUIRED=1
# FND_ALLOW_DEV_LOGIN=true

# Support contact form (optional — tickets always saved to DB)
# SUPPORT_NOTIFY_EMAIL=mxlilly@gmail.com
# RESEND_API_KEY=re_...
# SUPPORT_FROM_EMAIL=Friday Night Dynasty <onboarding@resend.dev>
