# Copy to .env (gitignored). Values: Firebase Console → Project settings → Your apps → Web app.
# Local dev: VITE_* works. Railway production: prefer FIREBASE_WEB_CONFIG_JSON or FND_FIREBASE_* (see docs/FIREBASE_SECRETS.md).

# VITE_API_BASE=
# VITE_ALLOW_DEV_LOGIN=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=friday-night-dynasty.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=friday-night-dynasty
VITE_FIREBASE_STORAGE_BUCKET=friday-night-dynasty.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Railway (server runtime) — same values, no VITE_ prefix:
# FND_FIREBASE_API_KEY=
# FND_FIREBASE_AUTH_DOMAIN=friday-night-dynasty.firebaseapp.com
# ... or one line:
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"...","authDomain":"...",...}
